# Copy to .env (cp .env.example .env) and replace the <placeholders>. Never commit .env. Placeholders only in this file.
# Run `npm run check:env` to see which of these are set/missing (it never prints values).
#
# Legend   [SMOKE] needed for the model smoke test AND eval:forms (Azure OpenAI only: no SQL, no blob)
#          [API]   needed for the full API (publish, packs, auth lookups, real deployment)
#          [opt]   optional, has a default

# =============================== Azure OpenAI ===============================
# [SMOKE]
FOUNDRY_API_KEY=<azure-openai-key>
# BASE url ending in /openai/v1  (the code appends /chat/completions; do NOT paste the full chat/completions URL)
# [SMOKE]
FOUNDRY_URL=https://<resource>.openai.azure.com/openai/v1
# The DEPLOYMENT name in Azure (not the model family). Defaults to gpt-4.1.
# [opt]
FOUNDRY_LLM_MODEL=gpt-4.1
# [opt] only used by the RAG features
FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small

# =============================== Environment selector ===============================
# dev | test | prod.  IF UNSET, config.js TREATS IT AS PROD (prod DB/container settings). Always set it locally.
# [API] (also needed by e2e:import)
FW_ENV=dev
# [opt]
PORT=3000
# [opt]
LOGGING_LEVEL=info
# Set to "console" to stop the API logger uploading/deleting log files in the blob container (the scripts do this themselves).
# [opt]
# FW_LOGGING_METHOD=console

# =============================== SQL Server (Azure SQL) ===============================
# Only the set matching FW_ENV is read (test uses the DEV server/login with APIDB_TEST).
# [API]
DB_SERVER_DEV=<server>.database.windows.net
# [API]
DB_USERNAME_DEV=<user>
# [API]
DB_PWD_DEV=<password>
# [API]
APIDB_DEV=<database-name>
# [API when FW_ENV=test]
APIDB_TEST=<database-name>
# [API when FW_ENV=prod]
DB_SERVER_PROD=<server>.database.windows.net
DB_USERNAME_PROD=<user>
DB_PWD_PROD=<password>
APIDB_PROD=<database-name>

# =============================== Blob storage ===============================
# [API] must be valid base64 or the logger crashes at start
BLOB_KEY=<base64-storage-account-key>
# [API] log container, matching FW_ENV
CONTAINER_NAME_DEV=<container>
CONTAINER_NAME_TEST=<container>
CONTAINER_NAME_PROD=<container>
# [opt] existing documents feature
DOCUMENTS_CONTAINER_NAME=<container>

# =============================== Auth (Azure AD / MSAL) ===============================
# All have built-in defaults in helpers/msalAuth.js; set only to override.
# [opt]
MSAL_TENANT_ID=<tenant-id>
# [opt]
MSAL_CLIENT_ID_DEV=<client-id>
# [opt]
MSAL_SCOPE_DEV=https://<app>.azurewebsites.net/user_impersonation
MSAL_CLIENT_ID_TEST=<client-id>
MSAL_SCOPE_TEST=https://<app>.azurewebsites.net/user_impersanation
MSAL_CLIENT_ID_PROD=<client-id>
MSAL_SCOPE_PROD=https://<app>.azurewebsites.net/user_impersanation
# LOCAL TESTING ONLY. Replaces the token check on the MIS import/pack routes with a fixed MIS-admin identity.
# The API REFUSES TO START with this set when NODE_ENV=production or FW_ENV=prod (or unset). Leave commented out.
# [opt] dev only
# DEV_AUTH_BYPASS=true
# [opt]
# DEV_AUTH_BYPASS_EMP_ID=1

# =============================== Form import ===============================
# Restricted container for uploaded source PDFs. If unset, imports work but the PDF is not stored.
# [opt]
FORM_IMPORT_CONTAINER_NAME=<container>
# Employees of this company count as MIS administrators (default 2000).
# [opt]
MIS_COMPANY_ID=2000

# =============================== Other existing integrations (not used by form import) ===============================
AUTH0_DOMAIN_DEV=<domain>
AUTH0_DOMAIN_PROD=<domain>
AUTH0_AUDIENCE_DEV=<audience>
AUTH0_AUDIENCE_PROD=<audience>
Auth0_Management_API_Client_ID_DEV=<id>
Auth0_Management_API_Client_ID_PROD=<id>
Auth0_Management_API_Client_Secret_DEV=<secret>
Auth0_Management_API_Client_Secret_PROD=<secret>
AUTH_POLICY_REPO_URL=<url>
BING_API=<key>
GOOGLE_MAPS_API_KEY=<key>
CLAIM_MD_API_KEY_TEST=<key>
CLAIM_MD_API_KEY_PROD=<key>
JSREPORT_URL=<url>
JSREPORT_USER=<user>
JSREPORT_PW=<password>
PG_DEV_URL=<postgres-connection-url>
PG_PROD_URL=<postgres-connection-url>
SMTP_USERNAME=<user>
SMTP_PWD=<password>
REACT_APP_CUSTOMERIOAPIKEY_DEVTEST=<key>
REACT_APP_CUSTOMERIOAPIKEY_PROD=<key>
REACT_APP_SEGMENTAPIKEY_DEVTEST=<key>
REACT_APP_SEGMENTAPIKEY_PROD=<key>
IN_APP_MESSAGE_APPROVAL_REJECTED_ID_DEVTEST=<id>
IN_APP_MESSAGE_APPROVAL_REJECTED_ID_PROD=<id>
IN_APP_MESSAGE_MISSED_CLOCK_IN_ID_DEVTEST=<id>
IN_APP_MESSAGE_MISSED_CLOCK_IN_ID_PROD=<id>
IN_APP_MESSAGE_MISSED_CLOCK_OUT_ID_DEVTEST=<id>
IN_APP_MESSAGE_MISSED_CLOCK_OUT_ID_PROD=<id>
IN_APP_MESSAGE_MT_STATUS_ID_DEVTEST=<id>
IN_APP_MESSAGE_MT_STATUS_ID_PROD=<id>
IN_APP_MESSAGE_MT_SUBMISSION_ID_DEVTEST=<id>
IN_APP_MESSAGE_MT_SUBMISSION_ID_PROD=<id>
IN_APP_MESSAGE_SHIFT_BROADCAST_ID_DEVTEST=<id>
IN_APP_MESSAGE_SHIFT_BROADCAST_ID_PROD=<id>
IN_APP_MESSAGE_TIMESHEET_SUBMISSION_ID_DEVTEST=<id>
IN_APP_MESSAGE_TIMESHEET_SUBMISSION_ID_PROD=<id>

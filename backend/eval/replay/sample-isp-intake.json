{
  "definition": {
    "display": "form",
    "components": [
      {
        "type": "content",
        "key": "instructions",
        "input": false,
        "label": "Instructions",
        "html": "<p><em>Instructions: Complete all fields marked with * . Print clearly. Submit to the Support Coordinator within 5 business days of enrollment.</em></p>"
      },
      {
        "type": "panel",
        "key": "sectionA",
        "title": "Section A — Individual Information",
        "input": false,
        "components": [
          {
            "type": "textfield",
            "key": "nameOfIndividual",
            "label": "Name of Individual",
            "input": true,
            "validate": {
              "required": true
            }
          },
          {
            "type": "datetime",
            "key": "dateOfBirth",
            "label": "Date of Birth",
            "input": true,
            "enableTime": false,
            "format": "MM/dd/yyyy",
            "validate": {
              "required": true
            }
          },
          {
            "type": "textfield",
            "key": "medicaidId",
            "label": "Medicaid ID",
            "input": true,
            "validate": {
              "required": true
            }
          },
          {
            "type": "textfield",
            "key": "phoneNumber",
            "label": "Phone Number",
            "input": true,
            "inputMask": "(999) 999-9999"
          },
          {
            "type": "textfield",
            "key": "dx",
            "label": "Dx",
            "input": true,
            "validate": {
              "required": false
            }
          },
          {
            "type": "radio",
            "key": "livingArrangement",
            "label": "Living Arrangement",
            "input": true,
            "validate": {
              "required": true
            },
            "values": [
              {
                "label": "Family home",
                "value": "familyHome"
              },
              {
                "label": "Supported apartment",
                "value": "supportedApartment"
              }
            ]
          },
          {
            "type": "textfield",
            "key": "county",
            "label": "County",
            "input": true,
            "validate": {
              "required": true
            }
          }
        ]
      },
      {
        "type": "panel",
        "key": "sectionB",
        "title": "Section B — Support Needs",
        "input": false,
        "components": [
          {
            "type": "radio",
            "key": "supportNeeds",
            "label": "Support Needs (check all that apply)",
            "input": true,
            "values": [
              {
                "label": "Mobility assistance",
                "value": "m"
              },
              {
                "label": "Personal care",
                "value": "p"
              }
            ]
          },
          {
            "type": "textarea",
            "key": "additionalNotesAboutSupportNeeds",
            "label": "Additional notes about support needs",
            "input": true,
            "rows": 4
          }
        ]
      },
      {
        "type": "panel",
        "key": "sectionC",
        "title": "Section C — Current Medications",
        "input": false,
        "components": [
          {
            "type": "datagrid",
            "key": "currentMedications",
            "label": "Current Medications",
            "input": true,
            "components": [
              {
                "type": "textfield",
                "key": "medication",
                "label": "Medication",
                "input": true,
                "validate": {
                  "required": false
                }
              },
              {
                "type": "textfield",
                "key": "dose",
                "label": "Dose",
                "input": true,
                "validate": {
                  "required": false
                }
              },
              {
                "type": "textfield",
                "key": "frequency",
                "label": "Frequency",
                "input": true,
                "validate": {
                  "required": false
                }
              },
              {
                "type": "textfield",
                "key": "prescriber",
                "label": "Prescriber",
                "input": true,
                "validate": {
                  "required": false
                }
              }
            ]
          }
        ]
      },
      {
        "type": "panel",
        "key": "sectionD",
        "title": "Section D — Consent",
        "input": false,
        "components": [
          {
            "type": "content",
            "key": "consentText",
            "input": false,
            "label": "Consent text",
            "html": "<p>By signing below, I confirm that the information provided is accurate to the best of my knowledge and I authorize the release of this information to the individual's support team.</p>"
          },
          {
            "type": "checkbox",
            "key": "consentAgree",
            "label": "I agree to the terms of consent above.",
            "input": true,
            "validate": {
              "required": true
            }
          }
        ]
      },
      {
        "type": "panel",
        "key": "sectionE",
        "title": "Section E — Signatures",
        "input": false,
        "components": [
          {
            "type": "signature",
            "key": "signatureOfIndividualGuardian",
            "label": "Signature of Individual / Guardian",
            "input": true,
            "validate": {
              "required": true
            }
          },
          {
            "type": "datetime",
            "key": "dateSigned",
            "label": "Date Signed",
            "input": true,
            "enableTime": false,
            "validate": {
              "required": true
            }
          },
          {
            "type": "signature",
            "key": "signatureOfSupportCoordinator",
            "label": "Signature of Support Coordinator",
            "input": true,
            "validate": {
              "required": true
            }
          },
          {
            "type": "datetime",
            "key": "dateSigned2",
            "label": "Date Signed",
            "input": true,
            "enableTime": false,
            "validate": {
              "required": true
            }
          },
          {
            "type": "content",
            "key": "retentionNote",
            "input": false,
            "label": "Retention note",
            "html": "<p><em>Note: A copy of this form must be retained in the individual's record for seven (7) years.</em></p>"
          }
        ]
      }
    ]
  },
  "fields": []
}
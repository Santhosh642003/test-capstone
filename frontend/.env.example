# Copy to .env  (cp .env.example .env  /  copy .env.example .env)
# Placeholders only. Never commit the real .env.

# ===== DEMO MODE (all you need for the meeting; no backend, no login) =====
REACT_APP_DEMO=1
REACT_APP_IMPORT_FORM_ENABLED=true

# ===== REAL MODE ONLY (unset REACT_APP_DEMO; needs the real FieldWorker environment) =====
# FWAPI base URLs (Import Form / Form Packs call <url>/task_form/...)
REACT_APP_APIURL_DEV=https://example-dev.azurewebsites.net/api/fieldworker
REACT_APP_APIURL_TEST=https://example-test.azurewebsites.net/api/fieldworker
REACT_APP_APIURL_PROD=https://example-prod.azurewebsites.net/api/fieldworker
# MIS API base URLs (existing MIS pages)
REACT_APP_APIURL1=https://example-mis-dev.azurewebsites.net/api/fieldworker
REACT_APP_APIURL2=https://example-mis-test.azurewebsites.net/api/fieldworker
REACT_APP_APIURL3=https://example-mis-prod.azurewebsites.net/api/fieldworker
# Azure AD (MSAL) login
REACT_APP_MSTENANT=https://login.microsoftonline.com/<tenant-id>
REACT_APP_CLIENT_ID_PROD=<azure-ad-client-id>
REACT_APP_SCOPE_PROD=https://<app>.azurewebsites.net/user_impersonation
# MUI X DataGrid Pro license (existing MIS pages; not needed for the new pages)
REACT_APP_MATERIAL_UI_LICENSE_KEY=<mui-license-key>
